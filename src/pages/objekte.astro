---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ObjekteHero from '../components/objekte/ObjekteHero.astro';
import ReferenzObjektCard from '../components/objekte/ReferenzObjektCard.astro';
import { referenzObjekte } from '../content/objekte';

// Hinweis: Solange keine echten, aktuell verfügbaren Objekte von Oliver Alberich vorliegen,
// zeigt diese Seite ausschließlich den anonymisierten Track Record (keine erfundenen Angebote).
// Seite ist bewusst noindex und nicht in der Navigation verlinkt.
// TODO: Sobald echte Objekte + Bilder vorliegen: aktiveObjekte-Sektion + Filter reaktivieren,
// noindex entfernen, Nav-/Footer-Link zurückholen.

const title = 'Referenzen | Reichentrog & Kollegen';
const description =
  'Ausgewählte abgeschlossene Mandate — anonymisiert. Ein Einblick in unsere diskrete Vermittlungspraxis in Hamburg.';
---

<BaseLayout {title} {description} noindex>
  <Nav variant="page" />

  <main id="main" data-cursor-surface="light">
    <ObjekteHero
      eyebrow="Track Record"
      title="Diskret vermittelt — ausgewählte Mandate."
      subtitle="Ein anonymisierter Einblick in abgeschlossene Transaktionen. Ohne Namen, ohne Adressen — so, wie wir auch Ihr Mandat behandeln."
    />

    <section class="bg-[#F5F0E8] py-16 md:py-20" aria-labelledby="objekte-ref-heading">
      <div class="mx-auto max-w-content px-6">
        <h2
          id="objekte-ref-heading"
          class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1c2b4a]/70"
        >
          Erfolgreich vermittelt
        </h2>
        <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {referenzObjekte.map((objekt) => <ReferenzObjektCard objekt={objekt} />)}
        </div>

        <div class="mt-16 border-t border-[#1c2b4a]/12 pt-12 text-center">
          <p class="mx-auto max-w-xl text-base leading-relaxed text-[#1c2b4a]/75">
            Sie erwägen einen Verkauf oder suchen ein bestimmtes Objekt? Sprechen Sie uns an — die meisten
            unserer Mandate laufen ohne öffentliches Inserat.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a
              href="/kontakt/"
              class="inline-flex items-center gap-2 rounded-full bg-[#1c2b4a] px-8 py-3.5 text-xs font-medium uppercase tracking-[0.12em] text-[#F5F0E8] shadow-lg transition hover:bg-steel-blue"
            >
              Erstgespräch anfragen
            </a>
            <a
              href="/objekt-anbieten/"
              class="inline-flex items-center gap-2 rounded-full border border-[#1c2b4a]/20 bg-white/60 px-8 py-3.5 text-xs font-medium uppercase tracking-[0.1em] text-[#1c2b4a] transition hover:bg-white"
            >
              Objekt anbieten
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
