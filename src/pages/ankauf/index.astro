---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import GlassCard from '../../components/GlassCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { ankaufIntro, ankaufProfiles } from '../../content/ankauf-profile';

const title = 'Ankauf & Ankaufsprofile | Reichentrog & Kollegen';
const description =
  'Ankaufsprofile für Wohnen, Büro, Sozialimmobilien und Grundstücke — Kriterien, Volumina, Standorte. Objekt diskret anbieten.';
---

<BaseLayout {title} {description}>
  <Nav variant="page" />
  <main id="main" class="bg-off-white pb-24 pt-28 md:pt-32" data-cursor-surface="light">
    <div class="mx-auto max-w-content px-6">
      <header class="max-w-3xl">
        <p class="text-[11px] font-medium uppercase tracking-[0.28em] text-bernstein">Immobilien-Ankauf</p>
        <h1 class="mt-4 font-display text-[clamp(2rem,4.5vw,3rem)] font-light leading-tight text-steel-navy">
          {ankaufIntro.title}
        </h1>
        <p class="mt-4 font-display text-xl text-steel-blue/90">{ankaufIntro.lead}</p>
        {
          ankaufIntro.body.map((p) => (
            <p class="mt-6 text-[0.95rem] leading-relaxed text-steel-navy/85">{p}</p>
          ))
        }
      </header>

      <section class="mt-16 border-t border-steel-blue/12 pt-16" aria-labelledby="profile-heading">
        <SectionHeader
          headingId="profile-heading"
          eyebrow="Profile A–D"
          title="Worauf wir achten"
          subtitle="Die Kurzfassung — vollständige Übersicht auch als PDF. Passendes Objekt? Dann direkt über „Objekt anbieten“ melden."
        />

        <div class="mt-14 grid gap-8 lg:grid-cols-2">
          {
            ankaufProfiles.map((profile) => (
              <GlassCard class="overflow-hidden p-0">
                <div class="border-b border-steel-blue/10 bg-steel-navy/5 px-8 py-6">
                  <h2 class="font-display text-2xl font-light text-steel-navy">{profile.name}</h2>
                </div>
                <div class="overflow-x-auto px-4 py-2 md:px-6">
                  <table class="w-full min-w-[280px] text-left text-sm">
                    <tbody>
                      {profile.rows.map((row) => (
                        <tr class="border-b border-steel-blue/8 last:border-0">
                          <th
                            scope="row"
                            class="w-[min(38%,11rem)] py-4 pr-4 align-top text-[0.8rem] font-semibold uppercase tracking-[0.06em] text-steel-navy/70"
                          >
                            {row.label}
                          </th>
                          <td class="py-4 text-steel-navy/85 leading-relaxed">{row.value}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </GlassCard>
            ))
          }
        </div>
      </section>

      <aside
        class="mt-14 rounded-2xl border border-steel-blue/12 bg-ice-blue/40 px-6 py-6 text-sm leading-relaxed text-steel-navy/80 md:px-8 md:py-8"
        role="note"
      >
        <p>
          <strong class="font-medium text-steel-navy">Hinweis zur Bearbeitung:</strong>
          {ankaufIntro.footnote}
        </p>
      </aside>

      <div class="mt-14 flex flex-wrap gap-4 border-t border-steel-blue/12 pt-14">
        <a
          href="/objekt-anbieten/"
          class="inline-flex items-center gap-2 rounded-full bg-steel-navy px-8 py-3.5 text-xs font-medium uppercase tracking-[0.12em] text-off-white shadow-lg transition hover:bg-steel-blue"
        >
          Objekt anbieten
        </a>
        <a
          href="/downloads/ankaufsprofile.pdf"
          download
          class="inline-flex items-center gap-2 rounded-full border border-steel-navy/20 bg-white px-8 py-3.5 text-xs font-medium uppercase tracking-[0.1em] text-steel-navy transition hover:bg-ice-blue/50"
        >
          PDF herunterladen
        </a>
        <a
          href="/kontakt/"
          class="inline-flex items-center gap-2 rounded-full border border-steel-blue/15 px-8 py-3.5 text-xs font-medium uppercase tracking-[0.1em] text-steel-navy transition hover:border-steel-navy/30"
        >
          Kontakt
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
