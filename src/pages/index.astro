---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GlassCard from '../components/GlassCard.astro';
import RevealSection from '../components/RevealSection.astro';
import SectionTransition from '../components/SectionTransition.astro';
import SectionHeader from '../components/SectionHeader.astro';
import HeroSection from '../components/HeroSection.astro';
import AllesAusEinerHand from '../components/AllesAusEinerHand.astro';
import BankenHintergrund from '../components/BankenHintergrund.astro';
import WarumSection from '../components/WarumSection.astro';
import OffMarketStatement from '../components/OffMarketStatement.astro';
import ZielgruppeSection from '../components/ZielgruppeSection.astro';
import CasesSection from '../components/CasesSection.astro';
import ReichweiteSection from '../components/ReichweiteSection.astro';
import TeamSection from '../components/TeamSection.astro';
import CtaBlock from '../components/CtaBlock.astro';
import GoogleReviewsSection from '../components/GoogleReviewsSection.astro';

const title = 'Reichentrog & Kollegen | Immobilienkanzlei Hamburg — Verkauf mit Banken-Kompetenz';
const description =
  'Immobilienkanzlei in Hamburg: Verkauf, Bewertung und Transaktionen mit Banken-Kompetenz — ohne Zwang zum Alleinauftrag, mit wöchentlichem Bericht. Für Eigentümer, Investoren und institutionelle Mandanten in Hamburg und ganz Deutschland.';

const faqItems = [
  {
    q: 'Was verstehen Sie unter Diskretion?',
    a: 'Wir bewerben Ihre Immobilie nicht unnötig öffentlich auf Portalen, sondern sprechen gezielt qualifizierte Nachfrager in unserem Netzwerk an. Ihr Auftrag bleibt vertraulich.',
  },
  {
    q: 'Benötige ich einen Alleinauftrag?',
    a: 'Nein zwingend. Wir stimmen das Mandat mit Ihnen individuell ab — von exklusiv bis begleitend, transparent und ohne Druck.',
  },
  {
    q: 'Entspricht Ihre Bewertung einem Gutachten?',
    a: 'Unsere Einordnungen sind fundiert und DEKRA-zertifiziert. Für Rechtsfälle erstellen wir auf Wunsch Verkehrswertgutachten nach ImmoWertV.',
  },
  {
    q: 'Unterstützen Sie bei Bankgesprächen?',
    a: 'Ja — mit langjähriger Sparkassen-Erfahrung begleiten wir Finanzierungs- und Konditionsgespräche sowie Förderwege.',
  },
  {
    q: 'Wie erfolgt die Honorierung nach Maklerrecht 2020?',
    a: 'Wir arbeiten nach aktuellem Recht. Die Provision wird vorab transparent vereinbart — abhängig von Auftrag und Leistungsbild.',
  },
  {
    q: 'In welchen Regionen sind Sie tätig?',
    a: 'Schwerpunkt Hamburg und Umgebung — Elbvororte, Alstertal, Harvestehude, Eppendorf. Für Geschäftskunden und institutionelle Mandate sind wir deutschlandweit aktiv.',
  },
];
---

<BaseLayout {title} {description} faq={faqItems}>
  <Nav />

  <main id="main">
    <!-- 1. Hero -->
    <HeroSection />

    <!-- 2. Zielgruppen-Weiche: Privat oder Geschäft — bewusst direkt nach dem Hero,
         damit Besucher ohne langes Scrollen zu ihrem Bereich finden. -->
    <ZielgruppeSection />

    <!-- 3. Alles aus einer Hand -->
    <SectionTransition
      id="alles-aus-einer-hand"
      featherTop={false}
      cursorSurface="light"
      class="bg-off-white py-24 md:py-32"
    >
      <div class="mx-auto max-w-content px-6">
        <AllesAusEinerHand />
      </div>
    </SectionTransition>

    <!-- 4. Warum -->
    <SectionTransition id="warum" featherTop={false} class="overflow-hidden p-0">
      <WarumSection />
    </SectionTransition>

    <!-- 5. Banken-Hintergrund -->
    <SectionTransition id="banken-hintergrund" featherTop={false} class="overflow-hidden p-0">
      <BankenHintergrund />
    </SectionTransition>

    <OffMarketStatement />

    <!-- 6. Ankauf -->
    <SectionTransition
      id="ankauf"
      featherTop={false}
      cursorSurface="light"
      class="bg-ice-blue py-24 md:py-32"
    >
      <div class="mx-auto max-w-content px-6">
        <RevealSection>
          <SectionHeader
            eyebrow="Ankauf"
            title="Wir suchen für unsere Mandanten"
            subtitle="Diskret und gezielt. Wenn Ihr Objekt zu einem unserer Ankaufsprofile passt, freuen wir uns auf Ihre Kontaktaufnahme."
          />
          <div class="mt-14 grid gap-6 md:grid-cols-2">
            {
              [
                {
                  t: 'Wohnimmobilien',
                  d: 'Einfamilien- und Mehrfamilienhäuser, Eigentumswohnungen — Hamburg & Umgebung.',
                },
                {
                  t: 'Gewerbeimmobilien',
                  d: 'Büro, Einzelhandel, Logistik — deutschlandweit.',
                },
                {
                  t: 'Grundstücke & Projektentwicklung',
                  d: 'Baugrundstücke, Revitalisierung, Umnutzungspotenziale.',
                },
                {
                  t: 'Portfolios & Beteiligungen',
                  d: 'Wohn- und Gewerbeportfolios, Kapitalanlagen.',
                },
              ].map((c) => (
                <GlassCard class="p-8">
                  <h3 class="font-display text-xl text-steel-navy">{c.t}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-steel-navy/75">{c.d}</p>
                </GlassCard>
              ))
            }
          </div>
          <div class="mt-12 flex flex-wrap gap-4">
            <a
              href="/geschaeftskunden/#ankauf"
              class="inline-flex items-center gap-2 rounded-full bg-steel-navy px-8 py-3.5 text-xs font-medium uppercase tracking-[0.12em] text-off-white shadow-lg transition hover:bg-steel-blue"
            >
              Alle Profile &amp; Kriterien
            </a>
            <a
              href="/downloads/ankaufsprofile.pdf"
              download
              class="inline-flex items-center gap-2 rounded-full border border-steel-navy/20 bg-white/60 px-8 py-3.5 text-xs font-medium uppercase tracking-[0.1em] text-steel-navy transition hover:bg-white"
            >
              PDF herunterladen
            </a>
            <a
              href="/objekt-anbieten/"
              class="inline-flex items-center gap-2 rounded-full border border-steel-navy/20 bg-white/60 px-8 py-3.5 text-xs font-medium uppercase tracking-[0.1em] text-steel-navy transition hover:bg-white"
            >
              Objekt anbieten
            </a>
          </div>
        </RevealSection>
      </div>
    </SectionTransition>

    <!-- 7. Cases -->
    <SectionTransition id="cases" cursorSurface="light" class="bg-ice-blue py-24 md:py-32">
      <div class="mx-auto max-w-content px-6">
        <CasesSection />
      </div>
    </SectionTransition>

    <!-- 8. Reichweite -->
    <SectionTransition
      id="reichweite"
      featherTop={false}
      cursorSurface="light"
      class="bg-off-white py-24 md:py-32"
    >
      <div class="mx-auto max-w-content px-6">
        <ReichweiteSection />
      </div>
    </SectionTransition>

    <!-- 9. Team -->
    <SectionTransition id="team" featherTop={false} class="relative">
      <TeamSection />
    </SectionTransition>

    <!-- 10. Stimmen (Google Reviews aus JSON-Cache) -->
    <SectionTransition
      id="stimmen"
      featherTop={false}
      cursorSurface="light"
      class="bg-off-white py-24 pb-28 md:py-32"
    >
      <div class="mx-auto max-w-content px-6">
        <GoogleReviewsSection />
      </div>
    </SectionTransition>

    <!-- 11. FAQ -->
    <SectionTransition
      id="faq"
      featherTop={false}
      cursorSurface="light"
      class="bg-[#EEE9E0] py-24 md:py-32"
    >
      <div class="mx-auto max-w-content px-6">
        <RevealSection>
          <SectionHeader eyebrow="FAQ" title="Häufig gestellte Fragen" align="center" class="mx-auto" />
          <div class="mx-auto mt-12 max-w-3xl">
            {
              faqItems.map((item) => (
                <details class="group border-b border-steel-blue/12 py-1">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display text-lg text-steel-navy transition hover:text-steel-blue">
                    <span>{item.q}</span>
                    <span
                      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-steel-blue/15 text-steel-navy/50 transition group-open:rotate-180"
                      aria-hidden="true"
                    >
                      ↓
                    </span>
                  </summary>
                  <p class="pb-5 text-sm leading-relaxed text-steel-navy/75">{item.a}</p>
                </details>
              ))
            }
          </div>
        </RevealSection>
      </div>
    </SectionTransition>

    <!-- 12. CTA -->
    <SectionTransition
      id="kontakt"
      featherTop={false}
      cursorSurface="light"
      class="bg-off-white py-24 md:py-32"
    >
      <div class="mx-auto max-w-content px-6">
        <CtaBlock />
      </div>
    </SectionTransition>
  </main>

  <Footer />
</BaseLayout>
