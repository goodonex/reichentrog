---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GlassCard from '../components/GlassCard.astro';
import SectionTransition from '../components/SectionTransition.astro';
import SegmentHero from '../components/SegmentHero.astro';
import UspStrip from '../components/UspStrip.astro';
import SegmentServices from '../components/SegmentServices.astro';
import CasesSection from '../components/CasesSection.astro';
import AnkaufProfilesSection from '../components/AnkaufProfilesSection.astro';
import GoogleReviewsSection from '../components/GoogleReviewsSection.astro';
import ContactForm from '../components/ContactForm.astro';
import { privatkundenServices, privatkundenUsps } from '../content/segments';

const title = 'Privatkunden | Reichentrog & Kollegen — Verkauf, Kauf, Bewertung';
const description =
  'Persönliche Immobilienberatung in Hamburg: diskreter Verkauf, Kaufberatung und DEKRA-zertifizierte Bewertung — hanseatisch, klar, ohne Marktgeräusch.';

---

<BaseLayout {title} {description}>
  <Nav variant="home" />

  <main id="main">
    <SegmentHero
      eyebrow="Privatkunden"
      headline="Ihre Immobilie verdient Ruhe — und einen klaren Plan."
      subline="Verkauf, Kauf oder Bewertung: Norbert Reichentrog begleitet Sie persönlich — diskret, nachvollziehbar und mit Banken-Hintergrund."
      primaryCta="Erstgespräch anfragen"
      primaryHref="#kontakt-form"
      secondaryCta="Objekt anbieten"
      secondaryHref="/objekt-anbieten/"
      videoMp4="/videos/privatkunden.mp4"
      fallbackPoster="/images/hero/hero-poster.jpg"
      fallbackPosterWebp="/images/hero/hero-poster.avif"
    />

    <UspStrip
      eyebrow="Warum Privatkunden uns wählen"
      title="Diskretion, die man spürt. Klarheit, die man braucht."
      items={privatkundenUsps}
    />

    <SectionTransition
      id="leistungen"
      featherTop={false}
      cursorSurface="light"
      class="bg-ice-blue py-24 md:py-32"
    >
      <div class="mx-auto max-w-content px-6">
        <SegmentServices
          eyebrow="Leistungen"
          title="Verkauf, Kauf, Bewertung — persönlich betreut"
          subtitle="Für Eigentümer in Hamburg: ruhige Beratung, klare Prozesse, nachvollziehbare Entscheidungen — ohne unnötige Öffentlichkeit."
          services={privatkundenServices}
        />
      </div>
    </SectionTransition>

    <SectionTransition id="referenzen" cursorSurface="light" class="bg-off-white py-24 md:py-32">
      <div class="mx-auto max-w-content px-6">
        <CasesSection audience="privat" />
      </div>
    </SectionTransition>

    <AnkaufProfilesSection />

    <SectionTransition
      id="stimmen"
      featherTop={false}
      cursorSurface="light"
      class="bg-ice-blue py-24 md:py-32"
    >
      <div class="mx-auto max-w-content px-6">
        <GoogleReviewsSection />
      </div>
    </SectionTransition>

    <SectionTransition
      id="kontakt-form"
      featherTop={false}
      cursorSurface="light"
      class="bg-off-white py-24 md:py-32"
    >
      <div class="mx-auto max-w-content px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-bernstein">
            Nächster Schritt
          </p>
          <h2 class="mt-4 font-display text-[clamp(1.875rem,3.5vw,2.75rem)] font-light text-steel-navy">
            Lassen Sie uns Ihr Anliegen einordnen.
          </h2>
          <p class="mx-auto mt-5 max-w-lg text-sm leading-relaxed text-steel-navy/75">
            Ein Erstgespräch verpflichtet zu nichts — aber spart oft Monate Unsicherheit.
          </p>
        </div>
        <GlassCard class="mx-auto mt-12 max-w-xl p-8 md:p-10">
          <ContactForm formName="privatkunden" segment="privatkunde" />
        </GlassCard>
      </div>
    </SectionTransition>
  </main>

  <Footer />
</BaseLayout>
