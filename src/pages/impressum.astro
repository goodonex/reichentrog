---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Impressum | Reichentrog & Kollegen"
  description="Impressum der Reichentrog & Kollegen GmbH."
>
  <Nav variant="page" />
  <main id="main" class="bg-off-white px-6 pb-24 pt-32" data-cursor-surface="light">
    <article class="mx-auto max-w-content text-steel-navy">
      <h1 class="font-display text-3xl text-steel-navy">Impressum</h1>

      <section class="mt-8 space-y-1 text-[0.98rem] leading-relaxed">
        <p><strong>Reichentrog &amp; Kollegen GmbH</strong></p>
        <p>Geschäftsführer: Norbert Heinz Reichentrog</p>
        <p>Karnapp 25, 21079 Hamburg</p>
        <p>Telefon: <a class="underline underline-offset-2" href="tel:+494041009000">040/41 00 90-0</a></p>
        <p>Telefax: 040/41 00 90-25</p>
        <p>
          E-Mail:
          <a class="underline underline-offset-2" href="mailto:info@reichentrog-finance.de">info@reichentrog-finance.de</a>
        </p>
      </section>

      <section class="mt-10 space-y-2 text-[0.98rem] leading-relaxed">
        <p>Vertreten durch den Geschäftsführer: Norbert Heinz Reichentrog</p>
        <p>Mitglied Handelskammer Hamburg, Adolphsplatz 1, 20457 Hamburg</p>
        <p>Registereintrag: Amtsgericht Hamburg HRB 124843</p>
        <p>Steuernummer: 47/754/00515</p>
        <p>USt-IdNr.: DE 259107166</p>
      </section>

      <section class="mt-10 space-y-2 text-[0.98rem] leading-relaxed">
        <h2 class="font-display text-2xl text-steel-navy">Erlaubnis nach § 34c GewO</h2>
        <!-- KUNDE BESTÄTIGEN: Zuständige Aufsichtsbehörde für Karnapp 25, 21079 Hamburg ist
             voraussichtlich das Bezirksamt Hamburg-Harburg (Fachamt Verbraucherschutz,
             Gewerbe & Umwelt). Behörde + exakten Wortlaut der Erlaubnis vom Mandanten bestätigen
             lassen, bevor die Seite live geht. -->
        <p class="mt-3">
          Die Reichentrog &amp; Kollegen GmbH ist Inhaberin einer Erlaubnis nach § 34c Absatz 1 der
          Gewerbeordnung (GewO).
        </p>
        <p>
          Zuständige Aufsichtsbehörde: Freie und Hansestadt Hamburg, Bezirksamt Hamburg-Harburg,
          Harburger Rathausforum 1, 21073 Hamburg.
        </p>
      </section>

      <section class="mt-10 space-y-2 text-[0.98rem] leading-relaxed">
        <h2 class="font-display text-2xl text-steel-navy">Verbraucherstreitbeilegung</h2>
        <p class="mt-3">
          Zur Teilnahme an einem Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle sind wir
          nicht verpflichtet und grundsätzlich nicht bereit (§ 36 VSBG).
        </p>
        <p>
          Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
          <a
            class="underline underline-offset-2"
            href="https://ec.europa.eu/consumers/odr/"
            target="_blank"
            rel="noopener noreferrer">https://ec.europa.eu/consumers/odr/</a
          >.
        </p>
      </section>

      <section class="mt-10">
        <h2 class="font-display text-2xl text-steel-navy">Bildrechte</h2>
        <!-- KUNDE BESTÄTIGEN: Bildnachweise gegen die tatsächlich verwendeten Assets abgleichen.
             Hero-/Segment-Videos und Teamfotos sind Eigen-/Auftragsproduktionen. -->
        <p class="mt-3 text-[0.98rem] leading-relaxed">
          Eigene Aufnahmen &amp; Auftragsproduktionen der Reichentrog &amp; Kollegen GmbH.
        </p>
      </section>

      <section class="mt-10">
        <h2 class="font-display text-2xl text-steel-navy">Konzeption und Programmierung</h2>
        <p class="mt-3 text-[0.98rem] leading-relaxed">HERRMANN &amp; CO.</p>
      </section>

      <section class="mt-10">
        <h2 class="font-display text-2xl text-steel-navy">Haftung für Inhalte und Links</h2>
        <p class="mt-3 text-[0.98rem] leading-relaxed text-steel-blue">
          Als Diensteanbieter sind wir gemäß § 7 Abs. 1 TMG für eigene Inhalte auf diesen Seiten nach den
          allgemeinen Gesetzen verantwortlich. Für Inhalte externer Links ist stets der jeweilige Anbieter
          verantwortlich. Zum Zeitpunkt der Verlinkung waren keine rechtswidrigen Inhalte erkennbar. Bei
          Bekanntwerden von Rechtsverletzungen entfernen wir entsprechende Inhalte umgehend.
        </p>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>
