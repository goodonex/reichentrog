---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import PageLoader from '../components/PageLoader.astro';
import CustomCursor from '../components/CustomCursor.astro';
import FloatingCta from '../components/FloatingCta.astro';
import { siteName, siteTagline, phoneHref, emailDisplay } from '../content/site';

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Optionale FAQ-Items → rendert zusätzlich FAQPage-Schema (z. B. Startseite). */
  faq?: FaqItem[];
}

const { title, description, noindex = false, faq } = Astro.props;
const siteUrl = Astro.site ?? new URL('http://localhost:5175');
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL('/images/hero/hero-poster.jpg', siteUrl).toString();

const telephone = phoneHref.replace('tel:', '');

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: siteName,
  description: siteTagline,
  url: siteUrl.toString(),
  logo: new URL('/icon-512.png', siteUrl).toString(),
  image: ogImage,
  telephone,
  email: emailDisplay,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Karnapp 25',
    postalCode: '21079',
    addressLocality: 'Hamburg',
    addressCountry: 'DE',
  },
  areaServed: 'Hamburg',
};

const faqSchema = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;

---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Reichentrog & Kollegen — Immobilien-Kanzlei Hamburg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2A2D52" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </head>
  <body class="min-h-screen">
    <PageLoader />
    <div id="scroll-progress" aria-hidden="true"></div>
    <FloatingCta />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200] focus:rounded-md focus:bg-bernstein focus:px-4 focus:py-2 focus:text-steel-navy">
      Zum Inhalt springen
    </a>
    <slot />
    <CookieBanner />
    <CustomCursor />
    <script>
      import '../scripts/main.ts';
    </script>
    <script is:inline>
      window.addEventListener('rk-consent-all', () => {
        const GA_MEASUREMENT_ID = 'G-XXXXXXXXXX';
        if (GA_MEASUREMENT_ID === 'G-XXXXXXXXXX') return;
        /* Meta Pixel: XXXXXXXXXXXXXXX — nach ID-Einreichung laden */
      });
    </script>
  </body>
</html>
