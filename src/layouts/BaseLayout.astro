---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import PageLoader from '../components/PageLoader.astro';
import CustomCursor from '../components/CustomCursor.astro';
import FloatingCta from '../components/FloatingCta.astro';
import { siteName, siteTagline } from '../content/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const siteUrl = Astro.site ?? new URL('http://localhost:5175');
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL('/images/hero/hero-poster.jpg', siteUrl).toString();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Reichentrog & Kollegen — Immobilien-Kanzlei Hamburg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2A2D52" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'RealEstateAgent',
      name: siteName,
      description: siteTagline,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Hamburg',
        addressCountry: 'DE',
      },
      areaServed: 'Hamburg',
    })} />
  </head>
  <body class="min-h-screen">
    <PageLoader />
    <div id="scroll-progress" aria-hidden="true"></div>
    <FloatingCta />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200] focus:rounded-md focus:bg-bernstein focus:px-4 focus:py-2 focus:text-steel-navy">
      Zum Inhalt springen
    </a>
    <slot />
    <CookieBanner />
    <CustomCursor />
    <script>
      import '../scripts/main.ts';
    </script>
    <script is:inline>
      window.addEventListener('rk-consent-all', () => {
        const GA_MEASUREMENT_ID = 'G-XXXXXXXXXX';
        if (GA_MEASUREMENT_ID === 'G-XXXXXXXXXX') return;
        /* Meta Pixel: XXXXXXXXXXXXXXX — nach ID-Einreichung laden */
      });
    </script>
  </body>
</html>
