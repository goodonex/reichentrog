---
import ReichentrogLogo from './ReichentrogLogo.astro';

/**
 * Schlank: Lead-Fokus (Segment-Seiten / Objekt anbieten). Keine langen Anker-Menüs.
 */
interface Props {
  /** Auf Unterseiten: kein Hero-Glas/Licht-Logo — sofort Lesbarkeit auf hellem Grund */
  variant?: 'home' | 'page';
}

const { variant = 'home' } = Astro.props;

/** Kern-Weiche: Privat- oder Geschäftskunde — als Segment-Toggle hervorgehoben,
 * damit Besucher innerhalb von Sekunden erkennen, wo sie hingehören. */
const segmentLinks = [
  { href: '/privatkunden/', label: 'Privatkunden' },
  { href: '/geschaeftskunden/', label: 'Geschäftskunden' },
];

// Hinweis: „Objekte" (Referenzen) ist bewusst nicht verlinkt, solange keine echten,
// aktuell verfügbaren Objekte vorliegen — die Seite ist noindex.
const links = [
  { href: '/objekt-anbieten/', label: 'Objekt anbieten', highlight: true },
  { href: '/kontakt/', label: 'Kontakt' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  id="site-nav"
  class="pointer-events-none fixed left-0 right-0 top-4 z-[200] flex justify-center px-4"
  data-on-hero={variant === 'home' ? 'true' : 'false'}
  data-no-hero={variant === 'page' ? 'true' : undefined}
>
  <div
    class="glass-nav-shell pointer-events-auto flex w-full max-w-4xl flex-col gap-1 rounded-full border px-2.5 py-1.5 shadow-[var(--glass-shadow)] backdrop-blur-[20px] backdrop-saturate-[180%] transition-[background,border-color,box-shadow] duration-500 md:flex-row md:items-center md:justify-between md:gap-1 md:px-3 md:py-1.5"
    style="--glass-radius: 9999px;"
    data-cursor-surface={variant === 'page' ? 'light' : undefined}
  >
    <div class="flex h-10 items-center justify-between md:h-10 md:justify-start md:gap-4">
      <a
        href="/"
        class="group min-w-0 shrink py-0 transition-opacity duration-300 hover:opacity-95"
        aria-label="Reichentrog &amp; Kollegen — Startseite"
      >
        <ReichentrogLogo layout="horizontal" compact />
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle-btn inline-flex h-8 w-8 items-center justify-center rounded-full text-steel-navy transition-colors duration-300 hover:bg-white/30 md:hidden"
        aria-controls="nav-panel"
        aria-expanded="false"
        aria-label="Menü öffnen"
      >
        <span class="sr-only">Navigation</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            stroke="currentColor"
            stroke-width="1.5"
            d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>

    <nav
      id="nav-panel"
      class="hidden flex-col gap-0.5 pb-1.5 md:flex md:flex-row md:items-center md:justify-end md:gap-0 md:pb-0"
      aria-hidden="true"
    >
      <div
        class="nav-segment-group mb-1.5 flex w-full items-center justify-center gap-0.5 rounded-full border px-1 py-1 md:mb-0 md:mr-2 md:w-auto md:justify-start"
        role="group"
        aria-label="Kundensegment wählen"
      >
        {
          segmentLinks.map(({ href, label }) => (
            <a
              href={href}
              class:list={[
                'nav-link nav-segment-link relative flex-1 whitespace-nowrap rounded-full px-3.5 py-2 text-center text-[11px] font-semibold uppercase tracking-[0.1em] transition-colors duration-300 md:flex-initial',
                currentPath === href.replace(/\/$/, '') && 'is-active',
              ]}
            >
              {label}
            </a>
          ))
        }
      </div>
      {
        links.map(({ href, label, highlight }) =>
          highlight ? (
            <a
              href={href}
              class="nav-highlight mt-1 rounded-full bg-steel-navy px-3.5 py-2 text-center text-[11px] font-semibold uppercase tracking-[0.1em] text-off-white transition hover:bg-steel-blue md:mt-0"
            >
              {label}
            </a>
          ) : (
            <a
              href={href}
              class="nav-link group relative whitespace-nowrap rounded-full px-3 py-2 text-[11px] font-medium uppercase tracking-[0.1em] text-steel-blue transition-colors duration-300 hover:text-steel-navy sm:px-3.5"
            >
              <span class="absolute inset-0 -z-10 scale-95 rounded-full bg-white/0 opacity-0 transition-all group-hover:scale-100 group-hover:bg-white/35 group-hover:opacity-100" />
              {label}
            </a>
          ),
        )
      }
    </nav>
  </div>
</header>
