---
import type { ReferenzObjekt } from '../../content/objekte';

interface Props {
  objekt: ReferenzObjekt;
}

const { objekt } = Astro.props;
---

<!-- TODO: Echte Objekt-Bilder von Oliver einsetzen -->
<article class="referenz-objekt-card overflow-hidden rounded-[var(--glass-radius)] border border-[#1c2b4a]/10 bg-white shadow-sm">
  <div class="relative aspect-[4/3] bg-[#2a3548]">
    <div class="referenz-objekt-card__overlay absolute inset-0 bg-[rgba(245,240,232,0.18)]" aria-hidden="true"></div>
    <div class="absolute inset-0 flex items-center justify-center px-6 text-center">
      <span class="text-[11px] uppercase tracking-[0.16em] text-[#F5F0E8]/35">Bild folgt</span>
    </div>
    <span
      class="absolute left-4 top-4 rounded-full bg-[#C9A96E]/95 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#1c2b4a]"
    >
      {objekt.badge}
    </span>
  </div>

  <div class="p-6 md:p-7">
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#1c2b4a]/65">
      {objekt.typLabel}
    </p>
    <p class="mt-4 text-sm leading-relaxed text-[#1c2b4a]/75">{objekt.beschreibung}</p>
    <p class="mt-6 border-t border-[#1c2b4a]/10 pt-5 text-sm italic text-[#1c2b4a]/65">
      {objekt.ergebnis}
    </p>
  </div>
</article>
