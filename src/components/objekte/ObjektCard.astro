---
import ObjektStatIcon from './ObjektStatIcon.astro';
import type { AktivesObjekt } from '../../content/objekte';
import { formatPreis } from '../../content/objekte';

interface Props {
  objekt: AktivesObjekt;
}

const { objekt } = Astro.props;
const kontaktHref = `/kontakt/?objekt=${encodeURIComponent(`${objekt.typLabel} — ${formatPreis(objekt.preis)}`)}`;
---

<!-- TODO: Echte Objekt-Bilder von Oliver einsetzen -->
<article
  class="objekt-card overflow-hidden rounded-[var(--glass-radius)] border border-[#1c2b4a]/10 bg-white shadow-sm transition-opacity duration-300"
  data-objekt-card
  data-objekt-price={objekt.preis}
  data-objekt-type={objekt.kategorie}
>
  <div class="relative aspect-[4/3] bg-[#2a3548]">
    <div class="absolute inset-0 flex items-center justify-center px-6 text-center">
      <span class="text-[11px] uppercase tracking-[0.16em] text-[#F5F0E8]/35">Bild folgt</span>
    </div>
    <span
      class="absolute left-4 top-4 rounded-full bg-[#1c2b4a]/90 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#F5F0E8]"
    >
      {objekt.badge}
    </span>
  </div>

  <div class="p-6 md:p-7">
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#1c2b4a]/65">
      {objekt.typLabel}
    </p>
    <p class="mt-3 font-display text-[28px] font-light leading-none text-[#1c2b4a]">
      {formatPreis(objekt.preis)}
    </p>
    <p class="mt-4 text-sm leading-relaxed text-[#1c2b4a]/75">{objekt.beschreibung}</p>

    <ul class="mt-6 grid gap-3 sm:grid-cols-3">
      {
        objekt.stats.map((stat) => (
          <li class="flex items-start gap-2 text-[#1c2b4a]/70">
            <ObjektStatIcon icon={stat.icon} class="mt-0.5 text-[#C9A96E]" />
            <span>
              <span class="block text-[10px] uppercase tracking-[0.12em] text-[#1c2b4a]/50">
                {stat.label}
              </span>
              <span class="text-sm font-medium text-[#1c2b4a]">{stat.value}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <!-- TODO: CTA-Formular an Netlify Forms oder bestehenden Handler anschließen -->
    <a
      href={kontaktHref}
      class="mt-8 inline-flex w-full items-center justify-center rounded-full bg-[#1c2b4a] px-6 py-3.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-[#F5F0E8] transition hover:bg-[#2e4e70]"
    >
      Anfrage stellen
    </a>
  </div>
</article>
