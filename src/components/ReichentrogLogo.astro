---
import CompassMark from './CompassMark.astro';

/**
 * Markenlogo aus 02_branding/reichentrog_logo_varianten_1.html
 * — horizontal (Navigation) oder gestapelt (Footer).
 * Farben über currentColor + .rk-logo / .rk-logo-footer (global.css).
 */
interface Props {
  layout?: 'horizontal' | 'stacked';
  /** Helle Wortmarke für dunkle Hintergründe (Footer, Hero) */
  variant?: 'default' | 'light';
  /** Kompakte Größe für die Navigation */
  compact?: boolean;
  class?: string;
}

const { layout = 'horizontal', variant = 'default', compact = false, class: className } = Astro.props;
---

<div
  class:list={[
    'rk-logo',
    layout === 'stacked' && 'rk-logo--stacked',
    variant === 'light' && 'rk-logo--light',
    className,
  ]}
>
  {
    layout === 'horizontal' ? (
      <div
        class:list={[
          'flex min-w-0 items-center',
          compact
            ? 'max-w-[min(100%,18rem)] gap-2.5 sm:min-w-[184px]'
            : 'max-w-[min(100%,22rem)] gap-2.5 sm:min-w-[200px] sm:gap-3.5 md:gap-4',
        ]}
      >
        <CompassMark
          class:list={[
            'shrink-0',
            compact ? 'h-8 w-8 sm:h-9 sm:w-9' : 'h-9 w-9 sm:h-10 sm:w-10 md:h-11 md:w-11',
          ]}
        />
        <div
          class:list={['w-px shrink-0 bg-current opacity-15', compact ? 'h-8 sm:h-9' : 'h-9 sm:h-10 md:h-11']}
          aria-hidden="true"
        />
        <div class="min-w-0">
          <div
            class:list={[
              'font-display font-normal uppercase leading-snug',
              compact
                ? 'text-[0.62rem] tracking-[0.13em] sm:text-[0.68rem] sm:tracking-[0.15em]'
                : 'text-[0.65rem] tracking-[0.14em] sm:text-[0.72rem] sm:tracking-[0.18em] md:text-[0.8rem] md:tracking-[0.2em]',
            ]}
          >
            Reichentrog <span class="italic font-light">&amp;</span> Kollegen
          </div>
          <p
            class:list={[
              'rk-logo-sub mt-0.5 font-display uppercase leading-tight',
              compact
                ? 'text-[6.5px] tracking-[0.24em] sm:text-[7.5px] sm:tracking-[0.28em]'
                : 'text-[7px] tracking-[0.28em] sm:text-[8px] sm:tracking-[0.34em] md:text-[9px] md:tracking-[0.38em]',
            ]}
          >
            Immobilienkanzlei
          </p>
        </div>
      </div>
    ) : (
      <div class="flex max-w-xs flex-col items-start gap-2.5">
        <CompassMark class="h-14 w-14 shrink-0" />
        <div class="w-full">
          <div class="font-display text-lg font-normal uppercase leading-snug tracking-[0.18em] md:text-xl md:tracking-[0.2em]">
            Reichentrog <span class="italic font-light">&amp;</span> Kollegen
          </div>
          <div class="mt-1 h-px w-full max-w-[14rem] bg-current opacity-15" aria-hidden="true" />
          <p class="rk-logo-sub mt-1.5 font-display text-[9px] uppercase tracking-[0.38em] md:text-[10px] md:tracking-[0.4em]">
            Immobilienkanzlei
          </p>
        </div>
      </div>
    )
  }
</div>
