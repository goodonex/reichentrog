<div
  id="qualification-quiz"
  class="quiz-modal"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="quiz-modal-title"
  aria-hidden="true"
>
  <div class="quiz-modal__backdrop" data-quiz-close tabindex="-1"></div>
  <div class="quiz-modal__panel" data-cursor-surface="light">
    <button type="button" class="quiz-modal__close" data-quiz-close aria-label="Quiz schließen">
      ×
    </button>

    <div class="quiz-modal__progress" aria-hidden="true">
      <span class="quiz-modal__dot is-active" data-quiz-dot="1"></span>
      <span class="quiz-modal__dot" data-quiz-dot="2"></span>
      <span class="quiz-modal__dot" data-quiz-dot="3"></span>
    </div>

    <div class="quiz-modal__step is-active" data-quiz-step="1">
      <h2 id="quiz-modal-title" class="quiz-modal__title">Worum geht es bei Ihrem Anliegen?</h2>
      <div class="quiz-modal__choices">
        <button type="button" class="quiz-modal__choice" data-quiz-anliegen="verkaufen">
          Ich möchte meine Immobilie verkaufen
        </button>
        <button type="button" class="quiz-modal__choice" data-quiz-anliegen="kauf">
          Ich suche eine Immobilie zum Kauf
        </button>
        <button type="button" class="quiz-modal__choice" data-quiz-anliegen="investor">
          Ich bin Investor oder Projektentwickler
        </button>
        <button type="button" class="quiz-modal__choice" data-quiz-anliegen="bewertung">
          Ich möchte zunächst nur den Wert wissen
        </button>
      </div>
    </div>

    <div class="quiz-modal__step" data-quiz-step="2" hidden>
      <div data-quiz-panel="preis" hidden>
        <h2 class="quiz-modal__title">In welchem Preissegment?</h2>
        <div class="quiz-modal__choices">
          <button type="button" class="quiz-modal__choice" data-quiz-preis="Unter 500k">
            Unter 500k
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-preis="500k–1,5 Mio">
            500k – 1,5 Mio
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-preis="1,5–3 Mio">
            1,5 – 3 Mio
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-preis="Über 3 Mio">
            Über 3 Mio
          </button>
        </div>
      </div>
      <div data-quiz-panel="investor" hidden>
        <h2 class="quiz-modal__title">Was suchen Sie?</h2>
        <div class="quiz-modal__choices">
          <button type="button" class="quiz-modal__choice" data-quiz-suchtyp="Einzelobjekt">
            Einzelobjekt
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-suchtyp="Portfolios">
            Portfolios
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-suchtyp="Projektentwicklung">
            Projektentwicklung
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-suchtyp="Orientierung">
            Orientierung
          </button>
        </div>
      </div>
      <button type="button" class="quiz-modal__back" data-quiz-back>← Zurück</button>
    </div>

    <div class="quiz-modal__step" data-quiz-step="3" hidden>
      <div data-quiz-panel="privat-umfang" hidden>
        <h2 class="quiz-modal__title">Wie viele Immobilien betrifft Ihr Anliegen?</h2>
        <div class="quiz-modal__choices">
          <button type="button" class="quiz-modal__choice" data-quiz-umfang="1 Objekt">
            1 Objekt
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-umfang="2–3 Objekte">
            2–3 Objekte
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-umfang="4+ Objekte">
            4+ Objekte
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-umfang="Portfolio / Bestand">
            Portfolio / Bestand
          </button>
        </div>
      </div>
      <div data-quiz-panel="geschaeft-umfang" hidden>
        <h2 class="quiz-modal__title">Wie oft transagieren Sie jährlich?</h2>
        <div class="quiz-modal__choices">
          <button type="button" class="quiz-modal__choice" data-quiz-umfang="1–2 Transaktionen">
            1–2 Transaktionen
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-umfang="3–5 Transaktionen">
            3–5 Transaktionen
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-umfang="6+ Transaktionen">
            6+ Transaktionen
          </button>
          <button type="button" class="quiz-modal__choice" data-quiz-umfang="Noch in Orientierung">
            Noch in Orientierung
          </button>
        </div>
      </div>
      <button type="button" class="quiz-modal__back" data-quiz-back>← Zurück</button>
    </div>

    <div class="quiz-modal__step" data-quiz-step="4" hidden>
      <p class="quiz-modal__result-eyebrow">Ihre Einordnung</p>
      <h2 class="quiz-modal__title" data-quiz-result-headline></h2>
      <p class="quiz-modal__result-copy" data-quiz-result-copy></p>
      <div class="quiz-modal__result-actions">
        <a href="/privatkunden/#kontakt-form" class="quiz-modal__result-cta" data-quiz-result-cta>
          Erstgespräch anfragen
          <span aria-hidden="true">→</span>
        </a>
        <a href="/privatkunden/" class="quiz-modal__result-secondary" data-quiz-result-page>
          Seite ansehen
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .quiz-modal {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .quiz-modal[hidden] {
    display: none;
  }

  .quiz-modal.is-open {
    display: flex;
  }

  .quiz-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 15, 28, 0.72);
    backdrop-filter: blur(6px);
  }

  .quiz-modal__panel {
    position: relative;
    z-index: 1;
    width: min(100%, 32rem);
    max-height: min(90vh, 640px);
    overflow-y: auto;
    border-radius: 1.25rem;
    border: 1px solid rgba(245, 240, 232, 0.12);
    background: #f5f2ea;
    padding: 2rem 1.75rem;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
  }

  .quiz-modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: none;
    background: rgba(26, 46, 78, 0.08);
    font-size: 1.5rem;
    line-height: 1;
    color: #1a2e4e;
    cursor: pointer;
    transition: background-color 200ms ease;
  }

  .quiz-modal__close:hover {
    background: rgba(26, 46, 78, 0.14);
  }

  .quiz-modal__progress {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .quiz-modal__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: rgba(26, 46, 78, 0.18);
    transition: background-color 200ms ease;
  }

  .quiz-modal__dot.is-active {
    background: #1a2e4e;
  }

  .quiz-modal__step {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 280ms ease,
      transform 280ms ease;
  }

  .quiz-modal__step.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .quiz-modal__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 1.875rem);
    font-weight: 400;
    line-height: 1.2;
    color: #1a2e4e;
  }

  .quiz-modal__choices {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .quiz-modal__choice {
    min-height: 52px;
    border-radius: 9999px;
    border: 1px solid rgba(26, 46, 78, 0.22);
    background: transparent;
    padding: 0.875rem 1.25rem;
    text-align: left;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: #1a2e4e;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
  }

  .quiz-modal__choice:hover,
  .quiz-modal__choice.is-selected {
    background: #1a2e4e;
    border-color: #1a2e4e;
    color: #f5f0e8;
  }

  .quiz-modal__back {
    margin-top: 1.25rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.875rem;
    color: rgba(26, 46, 78, 0.65);
    text-decoration: underline;
    text-underline-offset: 3px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .quiz-modal__result-eyebrow {
    margin-bottom: 0.5rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #cc9e4d;
  }

  .quiz-modal__result-copy {
    margin-top: 1rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(26, 46, 78, 0.78);
  }

  .quiz-modal__result-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .quiz-modal__result-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 52px;
    border-radius: 9999px;
    background: #1a2e4e;
    padding: 0.875rem 2rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f5f0e8;
    text-decoration: none;
    transition: background-color 200ms ease;
  }

  .quiz-modal__result-cta:hover {
    background: #2e4e70;
  }

  .quiz-modal__result-secondary {
    text-align: center;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    color: rgba(26, 46, 78, 0.65);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .quiz-modal__result-secondary:hover {
    color: #1a2e4e;
  }

  @media (prefers-reduced-motion: reduce) {
    .quiz-modal__step {
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  import { initQualificationQuiz } from '../scripts/qualification-quiz';

  initQualificationQuiz();
</script>
