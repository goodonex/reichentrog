---
import ReichentrogLogo from './ReichentrogLogo.astro';
import { siteTagline, phoneDisplay, phoneHref, emailDisplay, emailHref } from '../content/site';
---

<footer class="border-t border-steel-blue/15 bg-steel-navy pb-12 pt-16 text-ice-blue">
  <div class="mx-auto max-w-content px-6">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div>
        <a
          href="/"
          class="footer-brand rk-logo-footer inline-block transition-opacity hover:opacity-90"
          aria-label="Reichentrog &amp; Kollegen — Startseite"
        >
          <ReichentrogLogo layout="horizontal" variant="light" />
        </a>
        <p class="mt-4 max-w-sm text-sm text-ice-blue/90">{siteTagline}</p>
        <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-[0.12em] text-ice-blue/85">
          <a class="transition hover:text-bernstein" href="/privatkunden/">Privatkunden</a>
          <a class="transition hover:text-bernstein" href="/geschaeftskunden/">Geschäftskunden</a>
          <a class="transition hover:text-bernstein" href="/objekt-anbieten/">Objekt anbieten</a>
          <a class="transition hover:text-bernstein" href="/kontakt/">Kontakt</a>
        </nav>
      </div>
      <address class="not-italic md:text-right">
        <p class="text-sm font-medium text-off-white">Kontakt</p>
        <p class="mt-2 text-sm">
          <a class="hover:text-bernstein" href={phoneHref}>{phoneDisplay}</a>
        </p>
        <p class="text-sm">
          <a class="hover:text-bernstein" href={emailHref}>{emailDisplay}</a>
        </p>
        <p class="mt-3 text-sm text-ice-blue/80">Karnapp 25 · 21079 Hamburg</p>
      </address>
    </div>
    <div
      id="footer-dekra"
      class="mt-12 flex flex-col gap-8 border-t border-white/10 pt-10 md:flex-row md:items-center md:justify-between"
    >
      <div class="flex flex-wrap gap-6 text-xs uppercase tracking-[0.12em]">
        <a class="hover:text-bernstein" href="/impressum/">Impressum</a>
        <a class="hover:text-bernstein" href="/datenschutz/">Datenschutz</a>
      </div>
      <div class="flex items-center gap-4">
        <img
          src="/images/trust/dekra.png"
          alt="DEKRA — Sachverständige für Immobilienbewertung"
          width="300"
          height="468"
          class="h-14 w-auto opacity-95 md:h-16"
          loading="lazy"
          decoding="async"
          style="image-rendering: auto;"
        />
        <p class="max-w-xs text-[11px] leading-relaxed text-ice-blue/75">
          Zertifizierte Bewertungen — Details im Mandat.
        </p>
      </div>
    </div>
    <div class="mt-6 flex justify-end">
      <a
        href="https://herrmannundco.de"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[11px] uppercase tracking-[0.12em] text-ice-blue/60 transition hover:text-ice-blue/90"
      >
        Website &amp; Branding: HERRMANN &amp; CO.
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-brand :global(.rk-logo) {
    color: #f5f2ea;
  }

  .footer-brand :global(svg) {
    color: #f5f2ea;
  }

  .footer-brand :global(.rk-logo-sub) {
    opacity: 0.55;
  }
</style>
