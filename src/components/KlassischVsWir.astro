---
import RevealSection from './RevealSection.astro';
import SectionHeader from './SectionHeader.astro';

const rows = [
  {
    merkmal: 'Mandat',
    ueblich: 'Alleinauftrag ist die Regel — Sie binden sich zuerst.',
    wir: 'Kein Zwang zum Alleinauftrag. Das Mandat richtet sich nach Ihnen — von begleitend bis exklusiv.',
  },
  {
    merkmal: 'Vermarktung',
    ueblich: 'Inserat auf den großen Portalen, für jeden sichtbar.',
    wir: 'Gezielte Ansprache im gewachsenen Netzwerk. Öffentlich wird es nur, wenn Sie es wollen.',
  },
  {
    merkmal: 'Finanzierung',
    ueblich: 'Eine Finanzierungsbestätigung wird angefordert — dann wird gewartet.',
    wir: 'Wir führen die vollständige Finanzierungsakte und verhandeln in der Sprache der Banken.',
  },
  {
    merkmal: 'Bewertung',
    ueblich: 'Preisschätzung als Grundlage fürs Inserat.',
    wir: 'DEKRA-zertifizierte Bewertung, die auch vor der Bank standhält.',
  },
  {
    merkmal: 'Kommunikation',
    ueblich: 'Rückmeldung, wenn etwas passiert ist.',
    wir: 'Bericht jede Woche — auch dann, wenn gerade nichts passiert.',
  },
];
---

<RevealSection>
  <SectionHeader
    eyebrow="Der Unterschied"
    title="Nicht besser. Anders."
    subtitle="Der Satz stammt von uns selbst — und er ist wörtlich gemeint: Vieles machen wir bewusst anders, als es am Markt üblich ist."
  />

  <!-- Desktop: 3-Spalten-Tabelle -->
  <div class="mt-12 hidden md:block lg:mt-14">
    <div class="grid grid-cols-[1fr,1.4fr,1.4fr] gap-x-6 border-b border-steel-navy/12 pb-4">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-steel-navy/50">Merkmal</p>
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-steel-navy/50">Üblich am Markt</p>
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-bernstein">Reichentrog &amp; Kollegen</p>
    </div>
    {
      rows.map((row) => (
        <div class="grid grid-cols-[1fr,1.4fr,1.4fr] items-start gap-x-6 border-b border-steel-navy/8 py-6">
          <h3 class="font-display text-lg text-steel-navy">{row.merkmal}</h3>
          <p class="text-sm leading-relaxed text-steel-navy/60">{row.ueblich}</p>
          <div class="klassisch-vs-wir__highlight rounded-2xl border border-bernstein/25 bg-white/70 p-5">
            <p class="text-sm leading-relaxed text-steel-navy">{row.wir}</p>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Mobil: gestapelte Karten -->
  <div class="mt-10 flex flex-col gap-5 md:hidden">
    {
      rows.map((row) => (
        <div class="rounded-2xl border border-steel-navy/10 bg-white/50 p-6">
          <h3 class="font-display text-lg text-steel-navy">{row.merkmal}</h3>
          <p class="mt-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-steel-navy/40">
            Üblich am Markt
          </p>
          <p class="mt-1.5 text-sm leading-relaxed text-steel-navy/60">{row.ueblich}</p>
          <div class="klassisch-vs-wir__highlight mt-4 rounded-xl border border-bernstein/25 bg-white/70 p-4">
            <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-bernstein">
              Reichentrog &amp; Kollegen
            </p>
            <p class="mt-1.5 text-sm leading-relaxed text-steel-navy">{row.wir}</p>
          </div>
        </div>
      ))
    }
  </div>
</RevealSection>
