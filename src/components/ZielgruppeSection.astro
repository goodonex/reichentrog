---
import ServiceIcon from './ServiceIcon.astro';
import CompassMark from './CompassMark.astro';
import { privatkundenServices, geschaeftskundenServices } from '../content/segments';

const cards = [
  {
    href: '/privatkunden/',
    icon: 'privat' as const,
    eyebrow: 'Privatkunden',
    headline: 'Verkauf, Kauf, Bewertung',
    copy: 'Persönlich betreut — für Eigentümer in Hamburg und Umgebung.',
    services: privatkundenServices,
  },
  {
    href: '/geschaeftskunden/',
    icon: 'geschaeft' as const,
    eyebrow: 'Geschäftskunden',
    headline: 'Investoren & Projektentwickler',
    copy: 'Portfolios, Exits und Finanzierung — strukturiert und diskret.',
    services: geschaeftskundenServices,
  },
];
---

<section id="zielgruppe" class="zielgruppe-section bg-steel-navy py-20 md:py-28" aria-label="Zielgruppen-Auswahl">
  <div class="mx-auto max-w-content px-6">
    <div class="grid gap-6 md:grid-cols-2">
      {
        cards.map((card) => (
          <a href={card.href} class="zielgruppe-card group">
            <CompassMark class="pointer-events-none absolute -bottom-10 -right-10 -z-10 h-44 w-44 text-off-white opacity-[0.06] transition-[opacity,transform] duration-300 group-hover:opacity-[0.1] group-hover:rotate-[8deg]" />
            <span class="zielgruppe-card__icon" aria-hidden="true">
              <span class="zielgruppe-card__icon-glow" aria-hidden="true" />
              <ServiceIcon name={card.icon} class="h-7 w-7 text-bernstein" />
            </span>
            <p class="zielgruppe-card__eyebrow">{card.eyebrow}</p>
            <h2 class="zielgruppe-card__headline">{card.headline}</h2>
            <p class="zielgruppe-card__copy">{card.copy}</p>
            <ul class="zielgruppe-card__services" aria-label={`Leistungen für ${card.eyebrow}`}>
              {card.services.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <span class="zielgruppe-card__cta">
              Mehr erfahren
              <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
    <p class="zielgruppe-section__hint">
      Nicht sicher, welcher Bereich zu Ihnen passt? <a href="#kontakt-form">Sprechen wir kurz.</a>
    </p>
  </div>
</section>

<style>
  .zielgruppe-card {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(245, 240, 232, 0.14);
    background:
      radial-gradient(ellipse 120% 90% at 0% 0%, rgba(204, 158, 77, 0.09), transparent 55%),
      rgba(245, 240, 232, 0.035);
    padding: 2.25rem 2rem;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .zielgruppe-card:hover,
  .zielgruppe-card:focus-visible {
    border-color: rgba(204, 158, 77, 0.4);
    background:
      radial-gradient(ellipse 120% 90% at 0% 0%, rgba(204, 158, 77, 0.15), transparent 55%),
      rgba(245, 240, 232, 0.06);
    box-shadow: 0 20px 48px -20px rgba(0, 0, 0, 0.5);
    transform: translateY(-3px);
  }

  .zielgruppe-card__icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 9999px;
    background: rgba(204, 158, 77, 0.1);
    border: 1px solid rgba(204, 158, 77, 0.3);
  }

  .zielgruppe-card__icon-glow {
    position: absolute;
    inset: -10px;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(204, 158, 77, 0.35), transparent 70%);
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .zielgruppe-card:hover .zielgruppe-card__icon-glow,
  .zielgruppe-card:focus-visible .zielgruppe-card__icon-glow {
    opacity: 1;
  }

  .zielgruppe-card__eyebrow {
    margin-top: 1.5rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.6);
  }

  .zielgruppe-card__headline {
    margin-top: 0.6rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    font-weight: 300;
    line-height: 1.15;
    color: #f5f0e8;
  }

  .zielgruppe-card__copy {
    margin-top: 0.75rem;
    max-width: 26rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(245, 240, 232, 0.68);
  }

  .zielgruppe-card__services {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin: 1.75rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid rgba(245, 240, 232, 0.1);
    list-style: none;
  }

  .zielgruppe-card__services li {
    position: relative;
    padding-left: 1.1rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(245, 240, 232, 0.78);
  }

  .zielgruppe-card__services li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 1px;
    background: rgba(204, 158, 77, 0.7);
  }

  .zielgruppe-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #cc9e4d;
    transition: color 200ms ease;
  }

  .zielgruppe-card:hover .zielgruppe-card__cta,
  .zielgruppe-card:focus-visible .zielgruppe-card__cta {
    color: #f5f0e8;
  }

  .zielgruppe-section__hint {
    margin-top: 2.5rem;
    text-align: center;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    color: rgba(245, 240, 232, 0.55);
  }

  .zielgruppe-section__hint a {
    color: rgba(245, 240, 232, 0.85);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .zielgruppe-section__hint a:hover {
    color: #f5f0e8;
  }

  @media (prefers-reduced-motion: reduce) {
    .zielgruppe-card {
      transition: none;
    }
  }
</style>
