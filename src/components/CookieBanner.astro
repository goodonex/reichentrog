---

---

<div
  id="cookie-banner"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-live="polite"
  class="fixed bottom-0 left-0 right-0 z-[150] border-t border-steel-blue/20 bg-off-white/95 p-4 shadow-[var(--glass-shadow)] backdrop-blur-md md:p-6"
  data-cursor-surface="light"
>
  <div class="mx-auto flex max-w-content flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div class="max-w-3xl">
      <p id="cookie-title" class="font-display text-lg text-steel-navy">Wir nutzen Cookies</p>
      <p class="mt-1 text-sm leading-relaxed text-steel-blue">
        Um diese Website für Sie zu verbessern, setzen wir Cookies sowie Analyse- und Marketing-Tools
        (Google Analytics 4, Meta Pixel) ein — nur nach Ihrer Einwilligung. Details finden Sie in der
        <a class="underline decoration-bernstein/60 hover:text-steel-navy" href="/datenschutz/"
          >Datenschutzerklärung</a
        >.
      </p>
    </div>
    <div class="flex flex-shrink-0 flex-wrap gap-3">
      <button
        type="button"
        id="cookie-necessary"
        class="rounded-full border border-steel-blue/30 px-5 py-2.5 text-sm text-steel-navy hover:bg-ice-blue/80"
      >
        Nur notwendige
      </button>
      <button
        type="button"
        id="cookie-accept-all"
        class="rounded-full bg-steel-navy px-5 py-2.5 text-sm font-medium text-off-white hover:bg-steel-blue"
      >
        Alle akzeptieren
      </button>
    </div>
  </div>
</div>
