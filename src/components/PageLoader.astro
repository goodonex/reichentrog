---
import CompassMark from './CompassMark.astro';
---

<div
  id="page-loader"
  class="page-loader fixed inset-0 z-[500] flex items-center justify-center bg-[#1c2b4a] transition-opacity duration-[400ms] ease-out"
  aria-hidden="true"
>
  <CompassMark class="page-loader__compass h-16 w-16 text-[#f5f0e8]" />
</div>

<style>
  .page-loader.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .page-loader.is-done {
    display: none;
  }

  .page-loader__compass {
    animation: page-loader-spin 600ms ease-in-out 1 forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-loader__compass {
      animation: none;
    }

    .page-loader {
      transition: none;
    }
  }

  @keyframes page-loader-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
