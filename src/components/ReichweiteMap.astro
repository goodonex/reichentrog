---
/** Client-only Leaflet map — initialisiert per is:inline nach DOMContentLoaded. */
import { reichweiteLocations } from '../data/reichweite-locations';
---

<div
  id="reichweite-leaflet-map"
  class="reichweite-map__canvas h-[380px] w-full overflow-hidden rounded-md"
></div>

<style is:global>
  .reichweite-map .leaflet-control {
    display: none !important;
  }

  .reichweite-map .leaflet-tile-pane {
    filter: grayscale(100%) contrast(0.8) brightness(1.1);
  }

  .reichweite-map .reichweite-marker-icon {
    background: transparent !important;
    border: none !important;
  }

  .reichweite-map .reichweite-marker-dot {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #1c2b4a;
  }

  .reichweite-map .reichweite-marker-popup .leaflet-popup-content-wrapper {
    background: #f5f2ea;
    border: 1px solid rgba(26, 46, 78, 0.12);
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(26, 46, 78, 0.1);
    padding: 0;
  }

  .reichweite-map .reichweite-marker-popup .leaflet-popup-content {
    margin: 8px 12px;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
    color: #1a2e4e;
  }

  .reichweite-map .reichweite-marker-popup .leaflet-popup-tip {
    background: #f5f2ea;
    border: 1px solid rgba(26, 46, 78, 0.12);
    box-shadow: none;
  }
</style>

<script is:inline define:vars={{ markers: reichweiteLocations }}>
  (function () {
    var LEAFLET_CSS =
      'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
    var LEAFLET_JS =
      'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
    var MARKERS = markers;

    function loadStylesheet(href) {
      if (document.querySelector('link[href="' + href + '"]')) return;
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      link.crossOrigin = 'anonymous';
      document.head.appendChild(link);
    }

    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        if (window.L) {
          resolve();
          return;
        }
        var existing = document.querySelector('script[src="' + src + '"]');
        if (existing) {
          if (window.L) {
            resolve();
            return;
          }
          existing.addEventListener('load', resolve);
          existing.addEventListener('error', reject);
          return;
        }
        var script = document.createElement('script');
        script.src = src;
        script.crossOrigin = 'anonymous';
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    function invalidateWhenVisible(el, map) {
      var section = el.closest('[data-reveal]');
      if (!section) {
        setTimeout(function () {
          map.invalidateSize();
        }, 100);
        return;
      }

      var refresh = function () {
        map.invalidateSize();
      };

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) refresh();
          });
        },
        { threshold: 0.15 },
      );
      observer.observe(section);

      section.addEventListener('transitionend', refresh);
      window.addEventListener('resize', refresh);
    }

    function initMap() {
      var el = document.getElementById('reichweite-leaflet-map');
      if (!el || el.dataset.initialized === 'true' || !window.L) return;

      el.dataset.initialized = 'true';

      var map = window.L.map(el, {
        center: [53.55, 10.0],
        zoom: 10,
        scrollWheelZoom: false,
        zoomControl: false,
        attributionControl: false,
      });

      window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
      }).addTo(map);

      MARKERS.forEach(function (loc) {
        var icon = window.L.divIcon({
          className: 'reichweite-marker-icon',
          html: '<span class="reichweite-marker-dot"></span>',
          iconSize: [10, 10],
          iconAnchor: [5, 5],
        });

        window.L.marker([loc.lat, loc.lng], { icon: icon })
          .addTo(map)
          .bindPopup(loc.label, {
            className: 'reichweite-marker-popup',
            closeButton: false,
          });
      });

      invalidateWhenVisible(el, map);
    }

    function bootstrap() {
      loadStylesheet(LEAFLET_CSS);
      loadScript(LEAFLET_JS)
        .then(function () {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initMap);
          } else {
            initMap();
          }
        })
        .catch(function () {});
    }

    bootstrap();
  })();
</script>
