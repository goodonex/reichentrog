---
interface Props {
  class?: string;
  as?: 'div' | 'article' | 'section';
  tone?: 'light' | 'dark';
}

const Tag = Astro.props.as ?? 'div';
const { class: className, as: _as, tone = 'light', ...rest } = Astro.props;

const toneClass =
  tone === 'dark'
    ? [
        'border-white/18 bg-white/[0.08]',
        'hover:border-white/28 hover:bg-white/[0.14] hover:shadow-[0_24px_64px_-12px_rgba(0,0,0,0.35)]',
      ]
    : [
        'border-white/45 bg-white/45',
        'hover:border-white/60 hover:bg-white/55 hover:shadow-[0_24px_64px_-12px_rgba(26,46,78,0.18)]',
      ];
---

<Tag
  class:list={[
    'rounded-[var(--glass-radius)] shadow-[var(--glass-shadow)] backdrop-blur-[24px] backdrop-saturate-[180%]',
    'transition-all duration-500 ease-out will-change-transform',
    'hover:-translate-y-1',
    ...toneClass,
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
