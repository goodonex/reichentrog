---
/** Hero-Hintergrund: Autoplay-Loop Video (Desktop), Poster (Mobile). */
interface Props {
  posterAvif?: string;
  posterJpg?: string;
  videoMp4?: string;
  videoWebm?: string;
}

const assetVersion = '20260520-blankenese';

const {
  posterAvif = `/images/hero/hero-poster.avif?v=${assetVersion}`,
  posterJpg = `/images/hero/hero-poster.jpg?v=${assetVersion}`,
  videoMp4 = `/videos/hero-loop.mp4?v=${assetVersion}`,
  videoWebm = `/videos/hero-loop.webm?v=${assetVersion}`,
} = Astro.props;
---

<div
  id="hero-video-stack"
  class="hero-video-stack pointer-events-none absolute inset-0"
  aria-hidden="true"
>
  <picture class="hero-poster-wrap">
    <source srcset={posterAvif} type="image/avif" />
    <img
      id="hero-poster"
      src={posterJpg}
      alt=""
      width="1920"
      height="1080"
      class="hero-poster"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <video
    id="hero-video"
    class="hero-video"
    autoplay
    loop
    muted
    playsinline
    preload="auto"
    poster={posterJpg}
  >
    <source src={videoWebm} type="video/webm" />
    <source src={videoMp4} type="video/mp4" />
  </video>

  <div class="grain-overlay hero-video-grain" aria-hidden="true"></div>
</div>

<style>
  .hero-video-stack {
    z-index: 0;
    overflow: hidden;
  }

  .hero-poster-wrap,
  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    min-width: 100%;
    min-height: 100%;
    object-fit: cover;
    object-position: center;
    image-rendering: auto;
  }

  .hero-poster {
    z-index: 0;
    transition: opacity 400ms ease;
  }

  .hero-poster.is-hidden {
    opacity: 0;
  }

  .hero-video {
    z-index: 1;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .hero-video.is-ready {
    opacity: 1;
  }

  .hero-video-grain {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none !important;
    }

    .hero-poster.is-hidden {
      opacity: 1;
    }
  }

  @media (max-width: 767px) {
    .hero-video {
      display: none !important;
    }

    .hero-poster.is-hidden {
      opacity: 1;
    }
  }
</style>
