---
import { teamTextBlocks } from '../content/segments';
---

<section
  class="team-contact-section border-t border-steel-blue/12 bg-off-white py-24 md:py-32"
  aria-labelledby="team-text-heading"
  data-cursor-surface="light"
>
  <div class="mx-auto max-w-content px-6">
    <header class="mx-auto mb-14 max-w-2xl text-center md:mb-16">
      <p
        id="team-text-heading"
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-bernstein"
      >
        Ihre Ansprechpartner
      </p>
      <h2
        class="mt-4 font-display text-[clamp(1.875rem,3.5vw,2.75rem)] font-light leading-[1.1] text-steel-navy"
        style="text-wrap: balance;"
      >
        Persönliche Mandatsführung — kein Callcenter.
      </h2>
    </header>

    <div class="grid gap-10 lg:grid-cols-2 lg:gap-12">
      {
        teamTextBlocks.map((person) => (
          <article class="team-contact-card group">
            <div class="team-contact-card__frame">
              <div class="team-contact-card__portrait-wrap">
                <img
                  src={person.photo}
                  alt={person.photoAlt}
                  width="640"
                  height="800"
                  class="team-contact-card__portrait"
                  loading="lazy"
                  decoding="async"
                />
                <div class="team-contact-card__sheen" aria-hidden="true"></div>
              </div>
            </div>
            <div class="team-contact-card__body">
              <h3 class="font-display text-[clamp(1.625rem,2.5vw,2rem)] font-light leading-tight text-steel-navy">
                {person.name}
              </h3>
              <p class="mt-3 text-[11px] font-medium uppercase tracking-[0.18em] text-bernstein">
                {person.role}
              </p>
              <p class="mt-5 max-w-md text-[0.9375rem] leading-[1.75] text-steel-navy/78">
                {person.text}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team-contact-card {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .team-contact-card {
      gap: 2rem;
    }
  }

  .team-contact-card__frame {
    position: relative;
    padding: 0.65rem;
    border-radius: 1.25rem;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.92) 0%,
      rgba(224, 232, 239, 0.55) 100%
    );
    border: 1px solid rgba(26, 46, 78, 0.1);
    box-shadow:
      0 20px 50px rgba(26, 46, 78, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
  }

  .team-contact-card__portrait-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 0.85rem;
    aspect-ratio: 4 / 5;
    background: #e8e4dc;
  }

  @media (min-width: 768px) {
    .team-contact-card__portrait-wrap {
      aspect-ratio: 5 / 6;
      min-height: 420px;
    }
  }

  @media (min-width: 1024px) {
    .team-contact-card__portrait-wrap {
      min-height: 480px;
    }
  }

  .team-contact-card__portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 14%;
    transform: scale(1.16);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    filter: saturate(0.94) contrast(1.03);
  }

  .group:hover .team-contact-card__portrait,
  .group:focus-within .team-contact-card__portrait {
    transform: scale(1.19);
  }

  .team-contact-card__sheen {
    pointer-events: none;
    position: absolute;
    inset: 0;
    background: linear-gradient(
      165deg,
      rgba(255, 255, 255, 0.14) 0%,
      transparent 38%,
      rgba(10, 15, 28, 0.06) 100%
    );
  }

  .team-contact-card__body {
    padding: 0 0.35rem;
  }

  @media (min-width: 768px) {
    .team-contact-card__body {
      padding: 0 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-contact-card__portrait {
      transition: none;
    }

    .group:hover .team-contact-card__portrait,
    .group:focus-within .team-contact-card__portrait {
      transform: none;
    }
  }
</style>
