---
import SectionHeader from './SectionHeader.astro';
import RevealSection from './RevealSection.astro';
import ProcessStepIcon from './ProcessStepIcon.astro';

const steps = [
  {
    number: '01',
    eyebrow: 'Finanzierung & Markteinschätzung',
    label: 'Erstgespräch & Bewertung',
    content:
      'Wir beginnen mit einem vertraulichen Gespräch — keine Portale, keine öffentliche Ausschreibung. Wir bewerten Ihre Immobilie mit DEKRA-zertifizierten Methoden und zeigen Ihnen den realistischen Marktrahmen. Direkter Draht zu Privatbanken und freien Finanzierern inklusive.',
    icon: 'pen-paper' as const,
  },
  {
    number: '02',
    eyebrow: 'Diskretes Netzwerk',
    label: 'Strategie & Käufersuche',
    content:
      'Kein Portal-Rauschen. Wir gleichen Ihr Objekt mit unserem vorqualifizierten Käufer- und Investoren-Netzwerk ab — diskret, gezielt, ohne öffentliches Angebot. Family Offices, Privatbanken, Bestandshalter. Ihr Objekt bleibt geschützt bis Sie Ja sagen.',
    icon: 'network' as const,
  },
  {
    number: '03',
    eyebrow: 'Alles aus einer Hand',
    label: 'Verhandlung & Abwicklung',
    content:
      'Wir führen die Verhandlung, koordinieren Notar, Due Diligence und Finanzierungsbestätigung. Sie müssen keine einzige Schnittstelle selbst managen. Wir nehmen alles ab — von der ersten Anfrage bis zur Beurkundung.',
    icon: 'handshake' as const,
  },
  {
    number: '04',
    eyebrow: 'Sauberer Abschluss',
    label: 'Übergabe & Nachbetreuung',
    content:
      'Schlüsselübergabe, Protokoll, letzte Abstimmungen mit Notariat und Bank — sauber dokumentiert, persönlich begleitet. Und danach? Wir bleiben Ihr Ansprechpartner. Für die nächste Frage, den nächsten Schritt.',
    icon: 'key' as const,
  },
  {
    number: '05',
    eyebrow: 'Ihr Netzwerk auf Abruf',
    label: 'Nach dem Verkauf',
    content:
      'Der Verkauf ist abgeschlossen — aber nicht alles ist erledigt. Sanierung, Umzug, Entrümpelung, Handwerk: Unser Netzwerk aus geprüften Partnern steht Ihnen direkt zur Verfügung. Kein Suchen, kein Vergleichen. Wir vermitteln — Sie lehnen sich zurück.',
    icon: 'tools-network' as const,
  },
];
---

<RevealSection>
  <SectionHeader
    eyebrow="Alles aus einer Hand"
    title="Ein Ansprechpartner. Der gesamte Prozess."
    subtitle="Vom ersten Wertgespräch bis zur Schlüsselübergabe begleitet Sie ein Team — keine Schnittstellen, keine Umwege. Reichentrog & Kollegen koordiniert für Sie Finanzierung, Notariat, Abwicklung und alles, was darüber hinaus nötig wird. Sie führen ein Gespräch, wir nehmen den Rest in die Hand."
  />

  <div class="process-stepper mt-12 md:mt-14" data-process-stepper>
    <div class="process-stepper__layout">
      <div class="process-stepper__rail" role="tablist" aria-label="Ablauf in fünf Schritten">
        <div class="process-stepper__spine" aria-hidden="true">
          <div class="process-stepper__spine-track"></div>
          <div class="process-stepper__spine-fill" data-process-spine-fill style="--progress: 0%"></div>
        </div>

        <div class="process-stepper__rows">
          {
            steps.map((step, i) => (
              <div
                class:list={[
                  'process-stepper__row',
                  i % 2 === 0 ? 'process-stepper__row--left' : 'process-stepper__row--right',
                ]}
              >
                <span
                  class:list={['process-stepper__marker', i === 0 && 'is-active']}
                  data-process-marker={i}
                ></span>

                <button
                  type="button"
                  role="tab"
                  id={`process-tab-${i}`}
                  class:list={['process-stepper__card group', i === 0 && 'is-active']}
                  data-process-step={i}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls="process-panel"
                  tabindex={i === 0 ? 0 : -1}
                >
                  <span class="process-stepper__node" aria-hidden="true">
                    <ProcessStepIcon
                      name={step.icon}
                      class="!h-5 !w-5 !shrink-0 !text-[rgb(26,46,78)] opacity-55 transition-opacity duration-200 group-[.is-active]:opacity-100 group-[.is-active]:!text-[#f5f0e8]"
                    />
                    <span class="process-stepper__number">{step.number}</span>
                  </span>
                  <span class="process-stepper__copy">
                    <span class="process-stepper__eyebrow">{step.eyebrow}</span>
                    <span class="process-stepper__label">{step.label}</span>
                  </span>
                </button>
              </div>
            ))
          }
        </div>
      </div>

      <div
        id="process-panel"
        role="tabpanel"
        class="process-stepper__panel"
        data-process-panel
        aria-labelledby="process-tab-0"
      >
        <div class="process-stepper__panel-inner">
          {
            steps.map((step, i) => (
              <div
                class:list={['process-stepper__panel-slide', i === 0 && 'is-active']}
                data-process-slide={i}
                aria-hidden={i !== 0 ? 'true' : 'false'}
              >
                <div class="process-stepper__panel-icon">
                  <ProcessStepIcon name={step.icon} />
                </div>
                <div class="process-stepper__panel-body">
                  <p class="process-stepper__panel-eyebrow">{step.eyebrow}</p>
                  <h3 class="process-stepper__panel-title">{step.label}</h3>
                  <p class="process-stepper__panel-text">{step.content}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</RevealSection>

<style>
  .process-stepper__layout {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .process-stepper__panel {
    order: -1;
  }

  .process-stepper__rail {
    position: relative;
    margin-inline: auto;
    width: 100%;
    max-width: 44rem;
    padding: 0.25rem 0;
  }

  /* Vertikale Mittelachse */
  .process-stepper__spine {
    position: absolute;
    top: 1.625rem;
    bottom: 1.625rem;
    left: 1.125rem;
    width: 1px;
    z-index: 0;
  }

  .process-stepper__spine-track,
  .process-stepper__spine-fill {
    position: absolute;
    inset: 0;
    width: 1px;
    border-radius: 1px;
  }

  .process-stepper__spine-track {
    background: rgb(26 46 78 / 0.12);
  }

  .process-stepper__spine-fill {
    height: var(--progress, 0%);
    background: #1a2e4e;
    opacity: 0.45;
    transition: height 450ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .process-stepper.is-reduced-motion .process-stepper__spine-fill {
    transition: none;
    height: 100% !important;
  }

  .process-stepper__rows {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .process-stepper__row {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: center;
    column-gap: 0.875rem;
  }

  .process-stepper__marker {
    justify-self: center;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 9999px;
    background: #f5f2ea;
    border: 1.5px solid rgb(26 46 78 / 0.2);
    transition:
      background 200ms ease,
      border-color 200ms ease,
      transform 200ms ease;
  }

  .process-stepper__marker.is-active {
    background: #1a2e4e;
    border-color: #1a2e4e;
    transform: scale(1.15);
  }

  .process-stepper__card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1rem 1.125rem;
    text-align: left;
    background: rgb(255 255 255 / 0.55);
    border: 1px solid rgb(26 46 78 / 0.08);
    border-radius: 12px;
    cursor: pointer;
    opacity: 0.45;
    transition:
      opacity 220ms ease,
      background 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .process-stepper__card::before {
    content: '';
    position: absolute;
    top: 50%;
    right: calc(100% + 0.875rem);
    width: 0.875rem;
    height: 1px;
    background: rgb(26 46 78 / 0.12);
    transform: translateY(-50%);
  }

  .process-stepper__card:hover {
    opacity: 0.72;
  }

  .process-stepper__card.is-active {
    opacity: 1;
    background: rgb(26 46 78 / 0.05);
    border-color: #1a2e4e;
    box-shadow: 0 10px 36px rgb(26 46 78 / 0.1);
    transform: translateY(-1px);
  }

  .process-stepper__card.is-active::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    border-radius: 12px 0 0 12px;
    background: #cc9e4d;
  }

  .process-stepper__card:focus-visible {
    outline: 2px solid #1a2e4e;
    outline-offset: 3px;
  }

  .process-stepper__node {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1.5px solid rgb(26 46 78 / 0.14);
    background: #f5f2ea;
    transition:
      border-color 220ms ease,
      background 220ms ease,
      transform 220ms ease;
  }

  .process-stepper__card.is-active .process-stepper__node {
    border-color: #cc9e4d;
    background: #1a2e4e;
    transform: scale(1.08);
  }

  .process-stepper__number {
    position: absolute;
    right: -0.3rem;
    bottom: -0.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 9999px;
    border: 1.5px solid #f5f2ea;
    background: rgb(26 46 78 / 0.1);
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 9px;
    font-weight: 600;
    line-height: 1;
    color: #1a2e4e;
    transition:
      background 220ms ease,
      color 220ms ease;
  }

  .process-stepper__card.is-active .process-stepper__number {
    background: #cc9e4d;
    color: #1a2e4e;
    border-color: #f5f2ea;
  }

  .process-stepper__copy {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .process-stepper__eyebrow {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(26 46 78 / 0.55);
  }

  .process-stepper__card.is-active .process-stepper__eyebrow {
    color: rgb(26 46 78 / 0.72);
  }

  .process-stepper__label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 500;
    color: #1a2e4e;
  }

  .process-stepper__panel {
    min-height: 200px;
    padding: 1.75rem;
    border-radius: 16px;
    background: #f5f0e8;
    border: 1px solid rgb(26 46 78 / 0.08);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.65);
  }

  .process-stepper__panel-inner {
    display: grid;
    min-height: 140px;
  }

  .process-stepper__panel-slide {
    grid-area: 1 / 1;
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 300ms ease,
      visibility 300ms ease;
  }

  .process-stepper__panel-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .process-stepper.is-reduced-motion .process-stepper__panel-slide {
    transition: none;
  }

  .process-stepper__panel-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.55);
    border: 1px solid rgb(26 46 78 / 0.08);
  }

  .process-stepper__panel-eyebrow {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(26 46 78 / 0.55);
  }

  .process-stepper__panel-title {
    margin-top: 0.4rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.625rem;
    font-weight: 400;
    line-height: 1.15;
    color: #1a2e4e;
  }

  .process-stepper__panel-text {
    margin-top: 0.875rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: rgb(26 46 78 / 0.78);
  }

  @media (min-width: 768px) {
    .process-stepper__spine {
      left: 50%;
      transform: translateX(-50%);
      top: 2rem;
      bottom: 2rem;
    }

    .process-stepper__rows {
      gap: 1.125rem;
    }

    .process-stepper__row {
      grid-template-columns: 1fr auto 1fr;
      column-gap: 0;
      min-height: 4.75rem;
    }

    .process-stepper__marker {
      grid-column: 2;
      grid-row: 1;
      width: 0.6875rem;
      height: 0.6875rem;
    }

    .process-stepper__row--left .process-stepper__card {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      width: min(100%, 16rem);
      margin-right: 1.25rem;
    }

    .process-stepper__row--right .process-stepper__card {
      grid-column: 3;
      grid-row: 1;
      justify-self: start;
      flex-direction: row-reverse;
      text-align: right;
      width: min(100%, 16rem);
      margin-left: 1.25rem;
    }

    .process-stepper__row--left .process-stepper__card::before {
      right: -1.25rem;
      left: auto;
      width: 1.25rem;
    }

    .process-stepper__row--right .process-stepper__card::before {
      left: -1.25rem;
      right: auto;
      width: 1.25rem;
    }
  }

  @media (min-width: 960px) {
    .process-stepper__layout {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
      grid-template-rows: auto;
      gap: 0 2.75rem;
      align-items: start;
      max-width: 68rem;
      margin-inline: auto;
    }

    .process-stepper__panel {
      order: 0;
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 5.5rem;
      padding: 2.25rem;
      min-height: 16rem;
    }

    .process-stepper__rail {
      grid-column: 1;
      grid-row: 1;
      max-width: none;
      margin-inline: 0;
    }

    .process-stepper__panel-slide {
      flex-direction: column;
      gap: 1.25rem;
    }

    .process-stepper__panel-icon {
      width: 3rem;
      height: 3rem;
    }
  }

  @media (min-width: 960px) and (min-height: 700px) {
    .process-stepper__panel {
      padding: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-stepper__card,
    .process-stepper__number,
    .process-stepper__marker,
    .process-stepper__spine-fill,
    .process-stepper__panel-slide {
      transition: none !important;
    }

    .process-stepper__card.is-active {
      transform: none;
    }

    .process-stepper__spine-fill {
      height: 100% !important;
    }
  }
</style>
