---
/** Dünne Linien-Icons im Kompass-Stil — dunkelblau via currentColor */
interface Props {
  name: 'finanzierung' | 'abwicklung' | 'notariat' | 'netzwerk' | 'privat' | 'geschaeft';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['h-8 w-8 text-steel-navy', className]}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {
    name === 'finanzierung' && (
      <>
        <rect x="4" y="8" width="24" height="16" rx="1.5" stroke="currentColor" stroke-width="1" />
        <line x1="4" y1="13" x2="28" y2="13" stroke="currentColor" stroke-width="1" />
        <line x1="8" y1="18" x2="14" y2="18" stroke="currentColor" stroke-width="1" />
        <line x1="8" y1="21" x2="11" y2="21" stroke="currentColor" stroke-width="1" />
      </>
    )
  }
  {
    name === 'abwicklung' && (
      <>
        <path
          d="M8 6h12l4 4v16a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z"
          stroke="currentColor"
          stroke-width="1"
        />
        <path d="M20 6v4h4" stroke="currentColor" stroke-width="1" />
        <path d="M10 16h12M10 20h8" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
        <path d="M18 20l2 2 4-4" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
      </>
    )
  }
  {
    name === 'notariat' && (
      <>
        <path d="M16 4v20" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
        <path
          d="M12 24h8"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
        />
        <path
          d="M10 8c0-2 2.5-4 6-4s6 2 6 4"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
        />
        <circle cx="16" cy="14" r="3" stroke="currentColor" stroke-width="1" />
      </>
    )
  }
  {
    name === 'netzwerk' && (
      <>
        <circle cx="16" cy="10" r="3" stroke="currentColor" stroke-width="1" />
        <circle cx="8" cy="22" r="2.5" stroke="currentColor" stroke-width="1" />
        <circle cx="24" cy="22" r="2.5" stroke="currentColor" stroke-width="1" />
        <line x1="16" y1="13" x2="8" y2="19.5" stroke="currentColor" stroke-width="1" />
        <line x1="16" y1="13" x2="24" y2="19.5" stroke="currentColor" stroke-width="1" />
        <line x1="10.5" y1="22" x2="21.5" y2="22" stroke="currentColor" stroke-width="1" />
      </>
    )
  }
  {
    name === 'privat' && (
      <>
        <path d="M5 15 16 5l11 10" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M8 13v13h16V13" stroke="currentColor" stroke-width="1" stroke-linejoin="round" />
        <path d="M13 26v-8h6v8" stroke="currentColor" stroke-width="1" stroke-linejoin="round" />
      </>
    )
  }
  {
    name === 'geschaeft' && (
      <>
        <rect x="9" y="4" width="14" height="22" stroke="currentColor" stroke-width="1" />
        <line x1="12" y1="8" x2="12" y2="8.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <line x1="16" y1="8" x2="16" y2="8.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <line x1="20" y1="8" x2="20" y2="8.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <line x1="12" y1="12.5" x2="12" y2="12.51" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <line x1="16" y1="12.5" x2="16" y2="12.51" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <line x1="20" y1="12.5" x2="20" y2="12.51" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <line x1="12" y1="17" x2="12" y2="17.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <line x1="16" y1="17" x2="16" y2="17.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <line x1="20" y1="17" x2="20" y2="17.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <path d="M13 26v-5h6v5" stroke="currentColor" stroke-width="1" stroke-linejoin="round" />
        <line x1="4" y1="26" x2="28" y2="26" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
      </>
    )
  }
</svg>
