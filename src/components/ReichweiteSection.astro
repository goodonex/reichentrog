---
import SectionHeader from './SectionHeader.astro';
import RevealSection from './RevealSection.astro';
import ReichweiteMap from './ReichweiteMap.astro';
import { reichweiteLocations } from '../data/reichweite-locations';
---

<RevealSection>
  <div class="grid gap-14 lg:grid-cols-2 lg:items-center lg:gap-16">
    <div>
      <SectionHeader
        eyebrow="Reichweite"
        title="Hamburg verstehen wir am besten. Aber wir hören nicht an der Stadtgrenze auf."
        subtitle="Unser Schwerpunkt liegt in Hamburgs gewachsenen Lagen — Elbvororte, Alstertal, Harvestehude, Eppendorf. Genauso betreuen wir Objekte im Hamburger Umland, im Hamburger Süden und überregional, wenn unsere Mandanten dorthin verkaufen oder erwerben."
      />
    </div>
    <div
      class="reichweite-map relative mx-auto w-full max-w-md rounded-[var(--glass-radius)] bg-off-white p-8 pb-14 ring-1 ring-steel-navy/10"
    >
      <ReichweiteMap />
      <ul class="absolute bottom-6 left-6 right-6 flex flex-wrap gap-x-4 gap-y-1 text-[10px] uppercase tracking-[0.12em] text-steel-navy/55">
        {
          reichweiteLocations.map((loc) => (
            <li>{loc.label}</li>
          ))
        }
      </ul>
    </div>
  </div>
</RevealSection>
