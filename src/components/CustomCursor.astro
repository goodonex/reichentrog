<style is:global>
  body.has-custom-cursor,
  body.has-custom-cursor * {
    cursor: none !important;
  }

  body.has-custom-cursor .custom-cursor {
    display: block;
  }

  .custom-cursor {
    transition: color 220ms ease;
    will-change: transform;
  }

  .custom-cursor.is-on-light {
    color: #1c2b4a;
  }

  .custom-cursor__inner {
    transform-origin: center center;
    transition: transform 200ms ease;
  }

  .custom-cursor.is-hover .custom-cursor__inner {
    transform: scale(1.3);
    animation: custom-cursor-spin 2s linear infinite;
  }

  .custom-cursor.is-click .custom-cursor__inner {
    animation: none;
    transform: rotate(360deg);
    transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .custom-cursor.is-click.is-hover .custom-cursor__inner {
    transform: rotate(360deg) scale(1.3);
  }

  @keyframes custom-cursor-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-cursor {
      display: none !important;
    }

    body.has-custom-cursor,
    body.has-custom-cursor * {
      cursor: auto !important;
    }
  }

  @media (pointer: coarse) {
    .custom-cursor {
      display: none !important;
    }

    body.has-custom-cursor,
    body.has-custom-cursor * {
      cursor: auto !important;
    }
  }
</style>
